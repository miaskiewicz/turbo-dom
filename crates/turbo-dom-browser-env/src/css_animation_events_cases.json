[
  {
    "id": "css-animation-events",
    "html": "<!doctype html><html><head><style>@keyframes k { from { opacity: 0 } to { opacity: 1 } } @keyframes p { from { margin-left: 0px } to { margin-left: 10px } } div { margin-left: 0px; opacity: 1 } #d { transition: margin-left 10s linear 10s } #d.on { margin-left: 100px } #c { transition: opacity 10s linear } #c.on { opacity: 0 } #c.on.off { transition: none } #n { transition: margin-left 20s linear -2.5s } #n.on { margin-left: 50px } #s { transition: margin-left 10s linear 10s } #s.on { margin-left: 20px } #h { transition: opacity 40s linear } #h.on { opacity: 0.5 } #h.on.gone { display: none } #r { transition: opacity 20s linear } #r.on { opacity: 0 } #v { transition: opacity 10s linear } #v.on { opacity: 0 } #a.on { animation: k 10s linear 3 } #i.on { animation: k 10s linear infinite } #i.on.off { animation: none } #e.on { animation: p 10s linear 10s 2 } #g.on { animation: k 10s linear -15s 3 } #x.on { animation: k 20s linear } #x.on.gone { display: none } #m.on { animation: k 10s linear 2 } #z.on { animation: k 0s } #y.on { animation: k 10s linear 10s } #y.on.off { animation: none } #w.on { animation: k 10s linear 10s } #w.on.off { animation: none } #b { transition: opacity 10s linear 10s } #b.on { opacity: 0 } #b.on.off { transition: none }</style></head><body><div id=\"wrap\"><div id=\"d\"></div><div id=\"c\"></div><div id=\"n\"></div><div id=\"s\"></div><div id=\"h\"></div><div id=\"r\"></div><div id=\"v\"></div><div id=\"a\"></div><div id=\"i\"></div><div id=\"e\"></div><div id=\"g\"></div><div id=\"x\"></div><div id=\"m\"></div><div id=\"z\"></div><div id=\"y\"></div><div id=\"w\"></div><div id=\"b\"></div></div></body></html>",
    "frozenTimeline": false
  }
