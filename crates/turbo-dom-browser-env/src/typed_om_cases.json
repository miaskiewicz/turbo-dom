[{"id":"typed-om","html":"<!doctype html><html><head><base href=\"https://typed-om.test/assets/\"><style id=\"sheet\">.ruled { width: 10px; color: red; --v: 1px 2px; transition-duration: 1s, 2s }\n#styled { width: 50%; height: calc(10px + 5%); min-width: 2em; margin: 1px 2px 3px 4px; padding-inline-end: 6px; top: 10%; opacity: .5; z-index: 2; order: -1; display: flex; position: relative; visibility: hidden; color: #00ff00; background-color: rgba(0, 0, 255, 0.5); border-top: 2px solid; border-left-width: thick; outline-color: currentcolor; font-size: 20px; font-weight: bold; line-height: 1.5; letter-spacing: 0.1em; transition: opacity 200ms ease 1s; animation-name: spin, fade; transform: translateX(10px) rotate(0.25turn); translate: 1px 2px; rotate: 45deg; object-position: right 10px top; perspective-origin: left; transform-origin: 1px 2px; background-image: url(a.png), none; background-size: cover; border-top-left-radius: 1em; text-decoration-line: underline; text-transform: uppercase; text-indent: 1em; flex-grow: 2; flex-basis: 10rem; cursor: pointer; will-change: transform; pointer-events: none; --brand: #f00; --size: calc(1px + 2px); --inherited: yes }\n#child { --size: 9px; width: auto; margin-inline-start: 1em; inline-size: 30px; font-size: 50%; line-height: inherit; color: inherit; border-top-color: currentcolor; caret-color: auto }\n</style></head><body><div id=\"host\"></div><div id=\"ruled\" class=\"ruled\"></div><div id=\"plain\"></div><div id=\"styled\"><span id=\"child\"></span></div><div id=\"varied\" style=\"writing-mode: vertical-rl; direction: rtl; inline-size: 40px; margin-inline-start: 3px; padding-block-end: 2em; float: left; font-size: 12px; letter-spacing: 1rem; border-start-start-radius: 4px; color: rgb(10 20 30); --b: 7px; --a: var(--b, 5px); width: var(--a); transition-duration: 500ms; rotate: 1turn; min-height: calc(2em + 10%); top: -3px; z-index: 0; line-height: 2em\"><span id=\"varied-child\" style=\"opacity: inherit; border-left: thin dotted; outline-style: solid; --b: 9px\"></span></div><div hidden id=\"hidden\"></div><dialog open id=\"dialog\"></dialog><p id=\"para\"></p></body></html>"}]
