[
  {
    "id": "css-animations",
    "html": "<!doctype html><html><head><style>@keyframes k { from { opacity: 0; transform: none; color: red } to { opacity: 1; transform: translateX(10px); color: blue } } @keyframes k2 { 50% { opacity: 0.5; margin-left: 4px } } #a { animation: k 10s } #m { animation: k 10s, k2 5s linear 1s infinite alternate both } #n { animation: missing 3s } #t { opacity: 1; transition: opacity 2s ease-in 0.5s } #u { opacity: 1; transition: opacity 2s, color 1s } #w { opacity: 1; transition: all 3s linear } @keyframes many { from { z-index: 1; opacity: 0; rotate: 1deg; color: red; width: 1px; transform: none; margin-left: 1px; background-color: red; left: 1px; top: 1px; height: 2px; font-size: 3px; padding-top: 1px; border-top-color: red; filter: none; line-height: 2; translate: 1px; scale: 2; visibility: hidden; outline-color: red; letter-spacing: 1px } 60% { right: 1px; bottom: 1px } } #x { animation: many 2s } #hp { display: none } #h { animation: k 4s }</style></head><body><div id=\"a\"></div><div id=\"m\"></div><div id=\"n\"></div><div id=\"t\"></div><div id=\"u\"></div><div id=\"p\"></div><div id=\"w\"></div><div id=\"x\"></div><div id=\"hp\"><div id=\"h\"></div></div></body></html>",
    "frozenTimeline": true
  }
]
