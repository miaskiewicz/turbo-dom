crates/turbo-dom/src/rtdom/query_frozen.rs	s/^([ ]*)let mut cache = self\.(parse_cache|qcache)\.borrow_mut\(\);/$1let frozen = self.frozen_caches();\n$1let mut cache = frozen.$2.borrow_mut();/mg
