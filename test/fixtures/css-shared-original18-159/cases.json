[
  {"id":"media-active","css":"#target{color:red}@media screen and (min-width:1px){#target{color:blue}}","properties":["color"]},
  {"id":"media-inactive","css":"#target{color:red}@media (min-width:10000px){#target{color:blue}}","properties":["color"]},
  {"id":"supports-valid","css":"#target{color:red}@supports (display:grid){#target{color:blue}}","properties":["color"]},
  {"id":"supports-invalid","css":"#target{color:red}@supports (display:invented-display){#target{color:blue}}","properties":["color"]},
  {"id":"layer-order","css":"@layer early, late;@layer late{#target{color:blue}}@layer early{#target{color:red}}","properties":["color"]},
  {"id":"layer-important","css":"@layer early, late;@layer early{#target{color:red!important}}@layer late{#target{color:blue!important}}","properties":["color"]},
  {"id":"custom-inherited-case","css":"body{--Tone:blue}#target{color:var(--Tone,red)}","properties":["color"]},
  {"id":"custom-cycle-fallback","css":"#target{--a:var(--b);--b:var(--a);color:var(--a,green)}","properties":["color"]},
  {"id":"explicit-inherit","css":"body{color:blue;padding-left:20px}#target{color:inherit;padding-left:inherit}","properties":["color","padding-left"]},
  {"id":"css-wide","css":"body{color:blue}#target{color:initial;margin-left:unset}","properties":["color","margin-left"]},
  {"id":"font-units","css":"html{font-size:10px}body{font-size:20px}#target{font-size:2em;width:2rem;margin-left:1em}","properties":["font-size","width","margin-left"]},
