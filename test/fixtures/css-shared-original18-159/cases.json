  {"id":"calc-length","css":"#target{font-size:20px;margin-left:calc(1em + 2px)}","properties":["margin-left"]},
  {"id":"important-vs-inline","css":"#target{color:red!important}","inline":"color:blue","properties":["color"]},
  {"id":"focus-state","css":"#target{color:red}#target:focus{color:blue}","tag":"button","action":"focus","properties":["color"]},
  {"id":"before-pseudo","css":"#target{color:blue}#target::before{content:'x';color:red}","pseudo":"::before","properties":["color","content"]},
  {"id":"scope-rule","css":"#target{color:red}@scope (.scope){#target{color:blue}}","wrapper":"<div class=scope>","properties":["color"]},
  {"id":"container-rule","css":".scope{container-type:inline-size;container-name:box;width:400px}#target{color:red}@container box (min-width:300px){#target{color:blue}}","wrapper":"<div class=scope>","properties":["color"]}
